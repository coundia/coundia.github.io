{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "firstName",
    "lastName",
    "title",
    "headline",
    "roles",
    "tagline",
    "location",
    "timezone",
    "careerStart",
    "availability",
    "email",
    "links",
    "about",
    "summaryStrip"
  ],
  "properties": {
    "firstName": {
      "type": "string",
      "minLength": 1
    },
    "lastName": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "layer"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "frontend",
              "backend",
              "payment",
              "quality",
              null
            ]
          }
        }
      }
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "careerStart": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "label"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "from",
            "unavailable"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "email": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "about": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summaryStrip": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
