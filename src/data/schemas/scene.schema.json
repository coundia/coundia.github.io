{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "views",
    "nodes",
    "links",
    "grid",
    "packetsPerLink",
    "packetSpeed"
  ],
  "definitions": {
    "layer": {
      "enum": [
        "frontend",
        "backend",
        "payment",
        "quality"
      ]
    },
    "xz": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "zoom"
      ],
      "properties": {
        "target": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "properties": {
    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overview",
        "frontend",
        "backend",
        "payment",
        "quality"
      ],
      "properties": {
        "overview": {
          "$ref": "#/definitions/view"
        },
        "frontend": {
          "$ref": "#/definitions/view"
        },
        "backend": {
          "$ref": "#/definitions/view"
        },
        "payment": {
          "$ref": "#/definitions/view"
        },
        "quality": {
          "$ref": "#/definitions/view"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "position",
          "size",
          "layers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "box",
              "screen",
              "cylinder"
            ]
          },
          "position": {
            "$ref": "#/definitions/xz"
          },
          "size": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "layers": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/layer"
            }
          },
          "labelOffset": {
            "$ref": "#/definitions/xz"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "route",
          "layers"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "route": {
            "enum": [
              "xz",
              "zx"
            ]
          },
          "via": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/xz"
            }
          },
          "layers": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/layer"
            }
          }
        }
      }
    },
    "grid": {
      "type": "object",
      "required": [
        "halfX",
        "halfZ",
        "step"
      ],
      "properties": {
        "halfX": {
          "type": "number"
        },
        "halfZ": {
          "type": "number"
        },
        "step": {
          "type": "number"
        }
      }
    },
    "packetsPerLink": {
      "type": "object",
      "required": [
        "desktop",
        "mobile"
      ],
      "properties": {
        "desktop": {
          "type": "integer"
        },
        "mobile": {
          "type": "integer"
        }
      }
    },
    "packetSpeed": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
